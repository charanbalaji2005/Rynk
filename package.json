{
  "name": "rynk-monorepo",
  "private": true,
  "version": "0.3.0",
  "description": "Rynk \u2014 run any project, get a live link.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:tsc": "tsc -b tsconfig.build.json",
    "dev": "turbo run dev --parallel",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.build.json --pretty",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "rynk": "node packages/cli/dist/bin.js",
    "test:e2e": "vitest run tests/e2e",
    "test:unit": "vitest run --exclude tests/e2e/**"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@rynk/core": "workspace:*"
  }
}
